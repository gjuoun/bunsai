{
  "name": "bunsai",
  "version": "0.2.0",
  "description": "CI/CD in code, not YAML — portable pipeline runner on Bun + Effect-TS",
  "type": "module",
  "bin": {
    "bunsai": "src/cli.ts"
  },
  "scripts": {
    "test": "bun test",
    "check:structure": "bun scripts/check-structure.ts",
    "check:lazy": "bun scripts/check-lazy.ts",
    "verify:examples": "bash scripts/verify-examples.sh",
    "verify:cache": "bash scripts/verify-cache.sh",
    "check": "bun test && bunx tsc -p tsconfig.json --noEmit && bun scripts/check-structure.ts && bun scripts/check-lazy.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@effect/cli": "^0.77.2",
    "@effect/platform-bun": "^0.90.0",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "typescript": "5.9"
  }
}
